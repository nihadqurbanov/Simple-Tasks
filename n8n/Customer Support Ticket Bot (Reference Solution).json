        448,
        400
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e1",
              "name": "category",
              "type": "string",
              "value": "unclassified_empty"
            },
            {
              "id": "e2",
              "name": "replyText",
              "type": "string",
              "value": "It looks like your message was empty. Please describe your issue (e.g. billing, technical problem, or a currency question) and I'll route it to the right place."
            }
          ]
        },
        "options": {}
      },
