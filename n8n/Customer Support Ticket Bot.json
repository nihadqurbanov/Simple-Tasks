      "parameters": {
        "promptType": "define",
        "text": "={{ $json.messageText }}",
        "options": {
          "systemMessage": "Sən mesaj təsnifatçısısan. İstifadəçinin mesajını aşağıdakı 4 kateqoriyadan yalnız birinə təsnif et:\n- billing: ödəniş, hesab-faktura, abunə, kart, geri qaytarma (refund) ilə bağlı mesajlar\n- technical: xəta, nasazlıq, işləməmə, çökmə, texniki problemlərlə bağlı mesajlar\n- currency: məzənnə, valyuta, dollar/avro/manat çevrilməsi ilə bağlı mesajlar\n- general: yuxarıdakılardan heç birinə uyğun gəlməyən hər şey\n\nCavabında YALNIZ kateqoriyanın adını kiçik hərflərlə yaz (məs: billing). Başqa heç nə - izah, nöqtə, əlavə söz yazma."
        }
      },
      "id": "8d8a6cf7-4dd9-4cb8-9e84-8ee6884c7ab9",
      "name": "Kateqoriya Təyin Edən AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        80,
        256
      ]
    },
    {
      "parameters": {
        "jsCode": "const allowed = ['billing', 'technical', 'currency', 'general'];\nconst source = $('Extract Message Data').item.json;\nconst raw = ($json.output || '').toString();\n\nconst lower = raw.toLowerCase();\nconst found = allowed.find((c) => lower.includes(c));\nconst category = found || 'general';\n\nreturn {\n  json: {\n    ...source,\n    category,\n    llamaRawResponse: raw\n  }\n};"
      },
